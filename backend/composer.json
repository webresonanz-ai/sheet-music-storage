{
    "name": "sheet-music-storage/backend",
    "description": "REST API (PHP 8 + MySQL) for the Sheet Music Vault frontend",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t public public/router.php",
        "lint": "find src bootstrap public -name '*.php' -exec php -l {} \\;"
    }
}